<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Запустится и там, где установлен только .NET 9 или 10 -->
    <RollForward>Major</RollForward>
    <!-- XML-комментарии из кода собираются в файл документации -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <!-- Проект с тестами лежит внутри папки, но собирается отдельно -->
  <ItemGroup>
    <Compile Remove="PotteryWorkshop.Tests/**" />
    <Content Remove="PotteryWorkshop.Tests/**" />
    <None Remove="PotteryWorkshop.Tests/**" />
  </ItemGroup>

</Project>
