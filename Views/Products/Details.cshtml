@model Product
@{
    ViewData["Title"] = Model.Title;
}
<section class="section">
    <div class="container">
        <a asp-action="Index" class="link">← Вернуться в каталог</a>

        <div class="product">
            <img class="photo photo--big" src="@(Model.PhotoUrl ?? "/img/no-photo.jpg")" alt="@Model.Title" />

            <div class="product__info">
                <span class="muted">@Model.Category.Name</span>
                <h1>@Model.Title</h1>
                <p class="muted">@Model.Description</p>
                <div class="price price--big">@Model.Price.ToString("N0") ₽</div>

                @if (Model.Stock > 0)
                {
                    <span class="status status--visited">В наличии: @Model.Stock шт.</span>

                    if (User.Identity?.IsAuthenticated == true)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post" class="add-to-cart">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="qty" />
                            <button type="submit" class="btn">Добавить в корзину</button>
                        </form>
                    }
                    else
                    {
                        <p class="add-to-cart">
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn--outline">Войдите, чтобы купить</a>
                        </p>
                    }
                }
                else
                {
                    <span class="status status--cancelled">Нет в наличии</span>
                }
            </div>
        </div>
    </div>
</section>
