@model List<Product>
@{
    ViewData["Title"] = "Магазин";
    var categories = (List<Category>)ViewBag.Categories;
    var current = (int?)ViewBag.CurrentCategoryId;
    var search = ViewBag.Search as string;
}
<section class="page-hero">
    <div class="container">
        <span class="overline overline--light">Магазин</span>
        <h1>Изделия ручной работы</h1>
        <p>Готовая керамика, материалы и инструменты для творчества.</p>
    </div>
</section>

<section class="section">
    <div class="container shop">
        <aside class="sidebar">
            <h3>Категории</h3>
            <a asp-action="Index" asp-route-search="@search" class="side-link @(current == null ? "side-link--active" : "")">Все товары</a>
            @foreach (var c in categories)
            {
                <a asp-action="Index" asp-route-categoryId="@c.Id" asp-route-search="@search"
                   class="side-link @(current == c.Id ? "side-link--active" : "")">@c.Name</a>
            }
        </aside>

        <div class="shop__content">
            <form asp-action="Index" method="get" class="search">
                @if (current != null)
                {
                    <input type="hidden" name="categoryId" value="@current" />
                }
                <input type="text" name="search" value="@search" placeholder="Поиск по названию, например «кружка»" />
                <button type="submit" class="btn">Найти</button>
            </form>

            @if (!Model.Any())
            {
                <p class="muted">Ничего не найдено. Попробуйте изменить запрос или выбрать другую категорию.</p>
            }
            else
            {
                <p class="muted small">Найдено товаров: @Model.Count</p>
                <div class="grid grid--3">
                    @foreach (var product in Model)
                    {
                        <article class="card">
                            <div class="photo photo--product">фото изделия</div>
                            <div class="card__body">
                                <span class="muted small">@product.Category.Name</span>
                                <h4><a asp-action="Details" asp-route-id="@product.Id" class="card-link">@product.Title</a></h4>
                                <p class="muted small">@product.Description</p>
                                <div class="card__footer">
                                    <span class="price">@product.Price.ToString("N0") ₽</span>
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn--small">Подробнее</a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</section>
