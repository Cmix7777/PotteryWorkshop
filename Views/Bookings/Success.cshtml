@{
    ViewData["Title"] = "Запись оформлена";
}

<div style="padding: 100px; text-align: center;">
    <div style="max-width: 600px; margin: 0 auto; background: #FFFFFF; padding: 60px; border-radius: 20px; border: 1px solid #E8DFD0;">
        
        <div style="width: 80px; height: 80px; background: #E8F5E9; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 30px auto; font-size: 40px; color: #2E7D32;">
            ✓
        </div>

        <h1 style="font-family: Georgia, serif; color: #5C4033; font-size: 36px; margin: 0 0 20px 0;">Запись оформлена!</h1>
        
        <p style="color: #7A6652; font-size: 16px; line-height: 1.6; margin-bottom: 30px;">
            Спасибо! Администратор перезвонит вам в течение дня для подтверждения записи. 
            Статус записи появится в личном кабинете.
        </p>

        <div style="display: flex; gap: 15px; justify-content: center;">
            <a href="/" style="text-decoration: none; background-color: #8B5A3C; color: #F7F1E8; padding: 12px 30px; border-radius: 25px; font-size: 14px;">На главную</a>
            <a href="/Services" style="text-decoration: none; background-color: #F7F1E8; color: #8B5A3C; padding: 12px 30px; border-radius: 25px; font-size: 14px; border: 1.5px solid #8B5A3C;">Другие услуги</a>
        </div>
    </div>
</div>