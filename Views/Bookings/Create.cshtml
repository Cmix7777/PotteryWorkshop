@model PotteryWorkshop.Models.Booking

@{
    ViewData["Title"] = "Запись на занятие";
}

<!-- Hero -->
<div style="background-color: #5C4033; color: #F7F1E8; padding: 60px 100px;">
    <p style="font-size: 13px; letter-spacing: 3px; color: #D4A574; margin-bottom: 15px;">ЗАПИСЬ ОНЛАЙН</p>
    <h1 style="font-family: Georgia, serif; font-size: 48px; margin: 0 0 10px 0;">Запишитесь на занятие за минуту</h1>
    <p style="font-size: 16px; color: #D4C5B0; margin: 0;">Выберите тип урока и удобную дату, администратор перезвонит и подтвердит запись.</p>
</div>

<!-- Форма -->
<div style="padding: 60px 100px;">
    <div style="max-width: 700px; margin: 0 auto; background: #FFFFFF; padding: 40px; border-radius: 20px; border: 1px solid #E8DFD0;">
        
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <!-- Имя -->
            <div style="margin-bottom: 25px;">
                <label asp-for="FullName" style="display: block; color: #5C4033; font-size: 14px; font-weight: bold; margin-bottom: 8px;">Ваше имя *</label>
                <input asp-for="FullName" class="form-control" placeholder="Как к вам обращаться" 
                       style="width: 100%; padding: 12px 15px; border: 1px solid #E8DFD0; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                <span asp-validation-for="FullName" style="color: #C62828; font-size: 12px;"></span>
            </div>

            <!-- Телефон -->
            <div style="margin-bottom: 25px;">
                <label asp-for="Phone" style="display: block; color: #5C4033; font-size: 14px; font-weight: bold; margin-bottom: 8px;">Телефон *</label>
                <input asp-for="Phone" class="form-control" placeholder="+7 (___) ___-__-__" 
                       style="width: 100%; padding: 12px 15px; border: 1px solid #E8DFD0; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                <span asp-validation-for="Phone" style="color: #C62828; font-size: 12px;"></span>
            </div>

            <!-- Email -->
            <div style="margin-bottom: 25px;">
                <label asp-for="Email" style="display: block; color: #5C4033; font-size: 14px; font-weight: bold; margin-bottom: 8px;">Email</label>
                <input asp-for="Email" class="form-control" placeholder="your@email.com" 
                       style="width: 100%; padding: 12px 15px; border: 1px solid #E8DFD0; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
            </div>

            <!-- Тип урока (услуга) -->
            <div style="margin-bottom: 25px;">
                <label asp-for="ServiceId" style="display: block; color: #5C4033; font-size: 14px; font-weight: bold; margin-bottom: 8px;">Тип урока *</label>
                <select asp-for="ServiceId" class="form-control" 
                        style="width: 100%; padding: 12px 15px; border: 1px solid #E8DFD0; border-radius: 10px; font-size: 14px; box-sizing: border-box;">
                    <option value="">-- Выберите услугу --</option>
                    @foreach (var service in ViewBag.Services)
                    {
                        <option value="@service.Id" selected="@(ViewBag.SelectedServiceId == service.Id)">
                            @service.Title — @service.Price ₽
                        </option>
                    }
                </select>
                <span asp-validation-for="ServiceId" style="color: #C62828; font-size: 12px;"></span>
            </div>

            <!-- Дата -->
            <div style="margin-bottom: 25px;">
                <label asp-for="PreferredDate" style="display: block; color: #5C4033; font-size: 14px; font-weight: bold; margin-bottom: 8px;">Удобная дата *</label>
                <input asp-for="PreferredDate" type="date" class="form-control" 
                       style="width: 100%; padding: 12px 15px; border: 1px solid #E8DFD0; border-radius: 10px; font-size: 14px; box-sizing: border-box;" />
                <span asp-validation-for="PreferredDate" style="color: #C62828; font-size: 12px;"></span>
            </div>

            <!-- Комментарий -->
            <div style="margin-bottom: 30px;">
                <label asp-for="Comment" style="display: block; color: #5C4033; font-size: 14px; font-weight: bold; margin-bottom: 8px;">Комментарий</label>
                <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Особые пожелания или вопросы..." 
                          style="width: 100%; padding: 12px 15px; border: 1px solid #E8DFD0; border-radius: 10px; font-size: 14px; box-sizing: border-box; resize: vertical;"></textarea>
            </div>

            <!-- Кнопка -->
            <button type="submit" style="width: 100%; background-color: #8B5A3C; color: #F7F1E8; padding: 15px; border: none; border-radius: 25px; font-size: 16px; font-weight: bold; cursor: pointer;">
                Записаться
            </button>
        </form>

    </div>
</div>