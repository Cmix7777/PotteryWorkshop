@{
    ViewData["Title"] = "Отзыв отправлен";
}
<section class="section">
    <div class="container narrow success">
        <div class="success__icon">✓</div>
        <h1>Спасибо за отзыв!</h1>
        <p class="muted">Ваш отзыв отправлен на модерацию. После проверки администратором он появится в общем списке.</p>
        <a asp-action="Index" class="btn">Вернуться к отзывам</a>
    </div>
</section>
