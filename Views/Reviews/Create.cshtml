@model ReviewFormViewModel
@{
    ViewData["Title"] = "Оставить отзыв";
    var canReview = (bool)ViewBag.CanReview;
}
<section class="section">
    <div class="container form-page">
        <span class="overline">Отзывы</span>
        <h1>Оставить отзыв</h1>

        @if (!canReview)
        {
            <div class="alert alert--error">Отзыв можно оставить после посещения занятия или получения заказа. Записаться можно в разделе «Запись на занятия».</div>
            <a asp-action="Index" class="link">← Вернуться к отзывам</a>
        }
        else
        {
            <form asp-action="Create" method="post" class="form-card">
                <div asp-validation-summary="ModelOnly" class="form-error"></div>

                <label>Ваше имя</label>
                <input type="text" value="@User.Identity?.Name" disabled />

                <label asp-for="ServiceType"></label>
                <select asp-for="ServiceType" asp-items="@(new SelectList(ReviewFormViewModel.ServiceTypes))">
                    <option value="">— Выберите —</option>
                </select>
                <span asp-validation-for="ServiceType" class="field-error"></span>

                <label asp-for="Rating"></label>
                <select asp-for="Rating">
                    <option value="5">★★★★★ — Отлично</option>
                    <option value="4">★★★★☆ — Хорошо</option>
                    <option value="3">★★★☆☆ — Нормально</option>
                    <option value="2">★★☆☆☆ — Плохо</option>
                    <option value="1">★☆☆☆☆ — Ужасно</option>
                </select>
                <span asp-validation-for="Rating" class="field-error"></span>

                <label asp-for="Text"></label>
                <textarea asp-for="Text" rows="5" placeholder="Расскажите, что понравилось и что можно улучшить"></textarea>
                <span asp-validation-for="Text" class="field-error"></span>

                <button type="submit" class="btn btn--wide">Отправить на модерацию</button>
            </form>
        }
    </div>
</section>
