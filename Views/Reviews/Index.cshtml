@model List<Review>
@{
    ViewData["Title"] = "Отзывы";
    var filters = (List<string>)ViewBag.Filters;
    var current = ViewBag.CurrentFilter as string;
}
<section class="page-hero page-hero--reviews">
    <div class="container">
        <span class="overline overline--light">Отзывы</span>
        <h1>Что говорят наши ученики</h1>
        <p>Честные отзывы от тех, кто уже побывал на занятиях или купил наши изделия.</p>
    </div>
</section>

<section class="section">
    <div class="container shop">
        <aside class="sidebar">
            <h3>Фильтр по услуге</h3>
            <a asp-action="Index" class="side-link @(current == null ? "side-link--active" : "")">Все отзывы</a>
            @foreach (var f in filters)
            {
                <a asp-action="Index" asp-route-filter="@f" class="side-link @(current == f ? "side-link--active" : "")">@f</a>
            }
            <a asp-action="Create" class="btn btn--wide sidebar__btn">Оставить отзыв</a>
        </aside>

        <div class="shop__content reviews">
            @if (!Model.Any())
            {
                <p class="muted">В этой категории пока нет отзывов. <a asp-action="Index">Посмотреть все отзывы</a></p>
            }
            else
            {
                foreach (var review in Model)
                {
                    <article class="card card--padded">
                        <div class="stars">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</div>
                        <p>@review.Text</p>
                        <div class="review__footer">
                            <div>
                                <strong>@review.User.FullName</strong>
                                <div class="muted small">@review.ServiceType</div>
                            </div>
                            <span class="muted small">@review.CreatedAt.ToString("dd.MM.yyyy")</span>
                        </div>
                    </article>
                }
            }
        </div>
    </div>
</section>
