@model FeedbackViewModel
@{
    ViewData["Title"] = "Контакты";
    var topics = new[] { "Общий вопрос", "Запись на занятие", "Заказ в магазине", "Сотрудничество" };
}
<section class="page-hero">
    <div class="container">
        <span class="overline overline--light">Контакты</span>
        <h1>Как нас найти и связаться</h1>
        <p>Приходите в гости, звоните или пишите, мы всегда на связи.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="grid grid--3">
            <div class="card card--padded">
                <span class="muted small">Адрес</span>
                <h3>г. Ижевск, ул. Примерная, 1</h3>
                <p class="muted">Вход со двора, 2 этаж. Есть парковка.</p>
            </div>
            <div class="card card--padded">
                <span class="muted small">Телефон</span>
                <h3>+7 (3412) 00-00-00</h3>
                <a href="tel:+73412000000" class="btn btn--small contact-btn">Позвонить</a>
            </div>
            <div class="card card--padded">
                <span class="muted small">Часы работы</span>
                <h3>Вт – Вс, 11:00 – 21:00</h3>
                <p class="muted">Понедельник — выходной</p>
            </div>
            <div class="card card--padded">
                <span class="muted small">Почта</span>
                <h3>info@goncharnaya.ru</h3>
                <p class="muted">Отвечаем в течение дня</p>
            </div>
            <div class="card card--padded">
                <span class="muted small">Социальные сети</span>
                <h3>ВКонтакте, Telegram</h3>
                <p class="muted">Подписывайтесь на анонсы</p>
            </div>
            <div class="card card--padded">
                <span class="muted small">Реквизиты</span>
                <p>ИП Иванов И.И.<br />ИНН 1234567890<br />ОГРНИП 1234567890123</p>
            </div>
        </div>

        <h2 class="map-title">Карта проезда</h2>
        <!-- Карта подключается через внешний сервис Яндекс.Карты -->
        <iframe class="map" title="Карта проезда"
                src="https://yandex.ru/map-widget/v1/?ll=53.204843%2C56.852775&z=15&pt=53.204843%2C56.852775%2Cpm2rdm"
                allowfullscreen loading="lazy"></iframe>
    </div>
</section>

<section class="section section--sand">
    <div class="container form-page form-page--wide">
        <h2>Напишите нам</h2>
        <p class="muted">Есть вопрос или предложение? Заполните форму, и мы ответим в течение дня.</p>

        <form asp-action="Contacts" method="post" class="form-card">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <label asp-for="Name"></label>
            <input asp-for="Name" placeholder="Как к вам обращаться" />
            <span asp-validation-for="Name" class="field-error"></span>

            <label asp-for="Email"></label>
            <input asp-for="Email" placeholder="your@email.com" />
            <span asp-validation-for="Email" class="field-error"></span>

            <label asp-for="Topic"></label>
            <select asp-for="Topic" asp-items="@(new SelectList(topics))"></select>

            <label asp-for="Message"></label>
            <textarea asp-for="Message" rows="5" placeholder="Ваш вопрос или предложение"></textarea>
            <span asp-validation-for="Message" class="field-error"></span>

            <button type="submit" class="btn">Отправить</button>
        </form>
    </div>
</section>
