@{
    ViewData["Title"] = "Распределение задач";
}
<section class="section">
    <div class="container narrow">
        <span class="overline">О проекте</span>
        <h1>Распределение задач в команде</h1>
        <p class="muted">Сайт сделан в рамках учебной практики командой из двух человек. Работа разделена примерно 60 на 40.</p>

        <table class="table">
            <thead>
                <tr>
                    <th>Часть сайта</th>
                    <th>Айзат</th>
                    <th>Напарник</th>
                </tr>
            </thead>
            <tbody>
                <tr><td>Проектирование</td><td>карта сайта, роли и права, схема БД</td><td>анализ аналогов, цвета и шрифты</td></tr>
                <tr><td>Дизайн</td><td>проверка макетов по ТЗ</td><td>макеты страниц в Figma, UI-kit</td></tr>
                <tr><td>База данных</td><td>модели, связи, тестовые данные</td><td>тексты и фото для наполнения</td></tr>
                <tr><td>Регистрация и вход</td><td>логика, хеширование паролей, роли</td><td>вёрстка форм</td></tr>
                <tr><td>Главная, «О мастерской», «Контакты»</td><td>вывод данных из БД</td><td>вёрстка, общий шаблон, подвал</td></tr>
                <tr><td>Услуги и запись на занятия</td><td>логика записи, проверка мест</td><td>вёрстка страниц и формы</td></tr>
                <tr><td>Магазин</td><td>каталог, поиск, фильтры, корзина, заказ</td><td>вёрстка каталога и корзины</td></tr>
                <tr><td>Мероприятия и отзывы</td><td>регистрация, модерация отзывов</td><td>вёрстка страниц</td></tr>
                <tr><td>Личный кабинет</td><td>история заказов и записей</td><td>вёрстка кабинета</td></tr>
                <tr><td>Админ-панель</td><td>полностью</td><td>—</td></tr>
                <tr><td>Доводка</td><td>тестирование</td><td>адаптивность, оптимизация картинок</td></tr>
            </tbody>
        </table>
    </div>
</section>
