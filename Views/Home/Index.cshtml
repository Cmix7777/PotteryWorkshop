@model HomeViewModel
@{
    ViewData["Title"] = "Главная";
}

<section class="hero">
    <div class="container hero__inner">
        <div class="hero__text">
            <span class="overline overline--light">Мастер-класс недели</span>
            <h1>Создайте свой первый <span class="accent">горшок</span></h1>
            <p>Один вечер — и вы увезёте домой чашку, сделанную своими руками. Опыт не нужен, глина и фартук наши.</p>
            <div class="hero__buttons">
                <a asp-controller="Booking" asp-action="Index" class="btn">Записаться на занятие</a>
                <a asp-controller="Events" asp-action="Index" class="btn btn--outline-light">Смотреть расписание</a>
            </div>
        </div>
        <img class="photo photo--dark" src="~/img/hero.jpg" alt="Руки мастера за гончарным кругом" />
    </div>
</section>

<section class="section">
    <div class="container about">
        <div>
            <span class="overline">О мастерской</span>
            <h2>Лепим руками и учим этому других</h2>
            <p class="muted">Небольшая мастерская в центре города: шесть гончарных кругов, своя печь для обжига и мастера, которые объясняют без спешки. Здесь можно прийти на разовый мастер-класс, пройти курс или купить готовые изделия.</p>
            <a asp-controller="Home" asp-action="About" class="link">Подробнее о мастерской →</a>
        </div>
        <img class="photo" src="~/img/workshop.jpg" alt="Мастерская" />
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section__head">
            <div>
                <span class="overline">Услуги</span>
                <h2>Чему можно научиться</h2>
            </div>
            <a asp-controller="Services" asp-action="Index" class="link">Все услуги →</a>
        </div>
        <div class="grid grid--3">
            @foreach (var service in Model.Services)
            {
                <article class="card">
                    <img class="photo photo--card" src="@(service.PhotoUrl ?? "/img/no-photo.jpg")" alt="@service.Title" />
                    <div class="card__body">
                        <h3>@service.Title</h3>
                        <p class="muted">@service.Description</p>
                        <p class="price-line">от @service.Price.ToString("N0") ₽ · @(service.DurationMinutes / 60.0) ч</p>
                        <a asp-controller="Booking" asp-action="Index" class="btn btn--outline btn--small">Записаться</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section--sand">
    <div class="container">
        <div class="section__head">
            <div>
                <span class="overline">Мероприятия</span>
                <h2>Ближайшие мастер-классы</h2>
            </div>
            <a asp-controller="Events" asp-action="Index" class="link">Весь календарь →</a>
        </div>
        <div class="grid grid--3">
            @foreach (var item in Model.Events)
            {
                <article class="card">
                    <img class="photo photo--card" src="@(item.Event.PhotoUrl ?? "/img/no-photo.jpg")" alt="@item.Event.Title" />
                    <div class="card__body">
                    <span class="badge">@item.Event.StartsAt.ToString("d MMMM, HH:mm")</span>
                    <h3>@item.Event.Title</h3>
                    <p class="muted">@item.Event.Description</p>
                    <div class="card__footer">
                        @if (item.FreePlaces > 0)
                        {
                            <span class="muted small">Свободных мест: @item.FreePlaces</span>
                            <a asp-controller="Events" asp-action="Index" class="link">Зарегистрироваться →</a>
                        }
                        else
                        {
                            <span class="muted small">Мест нет</span>
                        }
                    </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section__head">
            <div>
                <span class="overline">Магазин</span>
                <h2>Изделия мастерской</h2>
            </div>
            <a asp-controller="Products" asp-action="Index" class="link">Перейти в магазин →</a>
        </div>
        <div class="grid grid--4">
            @foreach (var product in Model.Products)
            {
                <article class="card">
                    <img class="photo photo--product" src="@(product.PhotoUrl ?? "/img/no-photo.jpg")" alt="@product.Title" />
                    <div class="card__body">
                        <span class="muted small">@product.Category.Name</span>
                        <h4><a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="card-link">@product.Title</a></h4>
                        <div class="card__footer">
                            <span class="price">@product.Price.ToString("N0") ₽</span>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn--small">Подробнее</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section--sand">
    <div class="container">
        <div class="section__head">
            <div>
                <span class="overline">Отзывы</span>
                <h2>Что говорят ученики</h2>
            </div>
            <a asp-controller="Reviews" asp-action="Index" class="link">Все отзывы →</a>
        </div>
        <div class="grid grid--3">
            @foreach (var review in Model.Reviews)
            {
                <article class="card card--padded">
                    <div class="stars">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</div>
                    <p>@review.Text</p>
                    <strong>@review.User.FullName</strong>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section--dark">
    <div class="container cta">
        <div>
            <span class="overline overline--light">Запись онлайн</span>
            <h2>Запишитесь на занятие за минуту</h2>
            <p>Выберите тип урока и удобную дату, администратор подтвердит запись. Статус записи появится в личном кабинете.</p>
        </div>
        <a asp-controller="Booking" asp-action="Index" class="btn">Выбрать занятие</a>
    </div>
</section>

<section class="section">
    <div class="container contacts">
        <div>
            <span class="overline">Контакты</span>
            <h2>Как нас найти</h2>
            <p><span class="muted small">Адрес</span><br />г. Ижевск, ул. Примерная, 1</p>
            <p><span class="muted small">Телефон</span><br />+7 (3412) 56-34-12</p>
            <p><span class="muted small">Часы работы</span><br />Вт–Вс, 11:00–21:00</p>
        </div>
        <iframe class="map" title="Карта проезда" src="https://yandex.ru/map-widget/v1/?ll=53.204843%2C56.852775&z=15&pt=53.204843%2C56.852775%2Cpm2rdm" loading="lazy"></iframe>
    </div>
</section>
