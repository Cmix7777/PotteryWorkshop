@{
    ViewData["Title"] = "О мастерской";
}

<!-- Hero -->
<div style="background-color: #5C4033; color: #F7F1E8; padding: 80px 100px;">
    <p style="font-size: 13px; letter-spacing: 3px; color: #D4A574; margin-bottom: 15px;">О МАСТЕРСКОЙ</p>
    <h1 style="font-family: Georgia, serif; font-size: 56px; margin: 0 0 10px 0;">Место, где глина становится искусством</h1>
    <p style="font-size: 18px; color: #D4C5B0; margin: 0;">Мы создаём керамику руками и учим этому других с 2018 года.</p>
</div>

<!-- История -->
<div style="padding: 60px 100px;">
    <p style="font-size: 13px; letter-spacing: 3px; color: #8B5A3C; margin-bottom: 15px;">ИСТОРИЯ</p>
    <h2 style="font-family: Georgia, serif; font-size: 40px; color: #5C4033; margin-bottom: 30px;">Как всё начиналось</h2>
    
    <div style="display: flex; gap: 40px; align-items: flex-start;">
        <div style="flex: 1;">
            <p style="color: #7A6652; font-size: 16px; line-height: 1.7; margin-bottom: 20px;">
                Мастерская открылась в 2018 году в небольшом помещении в центре Ижевска. Тогда у нас было два гончарных круга и одна печь. Сегодня — шесть кругов, три мастера и сотни довольных учеников.
            </p>
            <p style="color: #7A6652; font-size: 16px; line-height: 1.7;">
                Мы верим, что работа с глиной — это не просто хобби, а способ замедлиться, почувствовать материал и создать что-то настоящее своими руками.
            </p>
        </div>
        <div style="width: 400px; height: 300px; background-color: #D4A574; opacity: 0.6; border-radius: 20px; display: flex; align-items: center; justify-content: center; color: #5C4033; flex-shrink: 0;">
            Фото мастерской 2018 года
        </div>
    </div>
</div>

<!-- Миссия -->
<div style="background-color: #EDE3D3; padding: 60px 100px;">
    <p style="font-size: 13px; letter-spacing: 3px; color: #8B5A3C; margin-bottom: 15px;">МИССИЯ</p>
    <h2 style="font-family: Georgia, serif; font-size: 40px; color: #5C4033; margin-bottom: 40px;">Что для нас важно</h2>
    
    <div style="display: flex; gap: 30px;">
        <div style="flex: 1; background: #FFFFFF; padding: 30px; border-radius: 16px;">
            <p style="font-family: Georgia, serif; font-size: 48px; font-weight: bold; color: #8B5A3C; margin: 0 0 10px 0;">01</p>
            <h3 style="font-family: Georgia, serif; font-size: 22px; color: #5C4033; margin: 0 0 15px 0;">Качество</h3>
            <p style="color: #7A6652; font-size: 14px; line-height: 1.6; margin: 0;">Используем только профессиональную глину и безопасные глазури. Каждое изделие проходит контроль.</p>
        </div>
        
        <div style="flex: 1; background: #FFFFFF; padding: 30px; border-radius: 16px;">
            <p style="font-family: Georgia, serif; font-size: 48px; font-weight: bold; color: #8B5A3C; margin: 0 0 10px 0;">02</p>
            <h3 style="font-family: Georgia, serif; font-size: 22px; color: #5C4033; margin: 0 0 15px 0;">Обучение</h3>
            <p style="color: #7A6652; font-size: 14px; line-height: 1.6; margin: 0;">Объясняем без спешки и сложных терминов. Подходит для новичков и опытных мастеров.</p>
        </div>
        
        <div style="flex: 1; background: #FFFFFF; padding: 30px; border-radius: 16px;">
            <p style="font-family: Georgia, serif; font-size: 48px; font-weight: bold; color: #8B5A3C; margin: 0 0 10px 0;">03</p>
            <h3 style="font-family: Georgia, serif; font-size: 22px; color: #5C4033; margin: 0 0 15px 0;">Атмосфера</h3>
            <p style="color: #7A6652; font-size: 14px; line-height: 1.6; margin: 0;">Уютное пространство, где можно отдохнуть от города и заняться творчеством.</p>
        </div>
    </div>
</div>

<!-- Команда -->
<div style="padding: 60px 100px;">
    <p style="font-size: 13px; letter-spacing: 3px; color: #8B5A3C; margin-bottom: 15px;">КОМАНДА</p>
    <h2 style="font-family: Georgia, serif; font-size: 40px; color: #5C4033; margin-bottom: 40px;">Наши мастера</h2>
    
    <div style="display: flex; gap: 30px;">
        <div style="flex: 1; background: #FFFFFF; border-radius: 20px; overflow: hidden; border: 1px solid #E8DFD0;">
            <div style="height: 280px; background-color: #D4A574; opacity: 0.6; display: flex; align-items: center; justify-content: center; color: #5C4033;">Фото мастера</div>
            <div style="padding: 25px;">
                <h3 style="font-family: Georgia, serif; font-size: 22px; color: #5C4033; margin: 0 0 5px 0;">Анна Петрова</h3>
                <p style="color: #8B5A3C; font-size: 14px; margin: 0 0 15px 0;">Главный мастер, 8 лет опыта</p>
                <p style="color: #7A6652; font-size: 14px; line-height: 1.5; margin: 0;">Специализация: гончарный круг, обжиг и глазирование.</p>
            </div>
        </div>
        
        <div style="flex: 1; background: #FFFFFF; border-radius: 20px; overflow: hidden; border: 1px solid #E8DFD0;">
            <div style="height: 280px; background-color: #D4A574; opacity: 0.6; display: flex; align-items: center; justify-content: center; color: #5C4033;">Фото мастера</div>
            <div style="padding: 25px;">
                <h3 style="font-family: Georgia, serif; font-size: 22px; color: #5C4033; margin: 0 0 5px 0;">Иван Сидоров</h3>
                <p style="color: #8B5A3C; font-size: 14px; margin: 0 0 15px 0;">Мастер-керамист, 5 лет опыта</p>
                <p style="color: #7A6652; font-size: 14px; line-height: 1.5; margin: 0;">Специализация: ручная лепка, декоративная керамика.</p>
            </div>
        </div>
        
        <div style="flex: 1; background: #FFFFFF; border-radius: 20px; overflow: hidden; border: 1px solid #E8DFD0;">
            <div style="height: 280px; background-color: #D4A574; opacity: 0.6; display: flex; align-items: center; justify-content: center; color: #5C4033;">Фото мастера</div>
            <div style="padding: 25px;">
                <h3 style="font-family: Georgia, serif; font-size: 22px; color: #5C4033; margin: 0 0 5px 0;">Мария Козлова</h3>
                <p style="color: #8B5A3C; font-size: 14px; margin: 0 0 15px 0;">Преподаватель, 6 лет опыта</p>
                <p style="color: #7A6652; font-size: 14px; line-height: 1.5; margin: 0;">Специализация: работа с детьми, семейные мастер-классы.</p>
            </div>
        </div>
    </div>
</div>