@model IEnumerable<PotteryWorkshop.Models.Service>

@{
    ViewData["Title"] = "Услуги";
}

<!-- Заголовок страницы -->
<div style="background-color: #5C4033; color: #F7F1E8; padding: 60px 100px;">
    <p style="font-size: 13px; letter-spacing: 3px; color: #D4A574; margin-bottom: 15px;">УСЛУГИ</p>
    <h1 style="font-family: Georgia, serif; font-size: 56px; margin: 0 0 10px 0;">Выберите формат обучения</h1>
    <p style="font-size: 18px; color: #D4C5B0; margin: 0;">От разового мастер-класса до индивидуального курса.</p>
</div>

<!-- Список услуг -->
<div style="padding: 60px 100px;">
    
    @foreach (var service in Model)
    {
        <div style="display: flex; gap: 40px; background: #FFFFFF; border-radius: 20px; padding: 30px; margin-bottom: 30px; border: 1px solid #E8DFD0;">
            
            <!-- Заглушка фото -->
            <div style="width: 300px; height: 250px; background-color: #D4A574; opacity: 0.6; border-radius: 16px; display: flex; align-items: center; justify-content: center; color: #5C4033; flex-shrink: 0;">
                Фото: @service.Photo
            </div>

            <!-- Описание -->
            <div style="flex: 1;">
                <h2 style="color: #5C4033; font-family: Georgia, serif; font-size: 32px; margin: 0 0 10px 0;">@service.Title</h2>
                <p style="color: #8B5A3C; font-weight: bold; font-size: 15px; margin: 0 0 20px 0;">
                    @service.Kind · @service.DurationMin мин
                </p>
                <p style="color: #7A6652; font-size: 15px; line-height: 1.6; margin-bottom: 25px;">
                    @service.Description
                </p>

                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: #5C4033; font-family: Georgia, serif; font-size: 24px; font-weight: bold;">
                        от @service.Price ₽
                    </span>
                    <a href="/Bookings/Create?serviceId=@service.Id" 
                       style="text-decoration: none; background-color: #8B5A3C; color: #F7F1E8; 
                              padding: 12px 30px; border-radius: 25px; font-size: 15px; font-weight: bold;">
                        Записаться
                    </a>
                </div>
            </div>
        </div>
    }

</div>