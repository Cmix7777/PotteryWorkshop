@model ProfileViewModel
@{
    ViewData["Title"] = "Личный кабинет";
    var orders = (List<Order>)ViewBag.Orders;
    var events = (List<EventRegistration>)ViewBag.Events;
}
<section class="page-hero page-hero--cabinet">
    <div class="container">
        <span class="overline overline--light">Личный кабинет</span>
        <h1>Профиль и заказы</h1>
        <p>Ваши данные, история заказов и мероприятия.</p>
    </div>
</section>

<section class="section">
    <div class="container cabinet">
        <aside class="sidebar">
            <h3>Личный кабинет</h3>
            <a asp-controller="Profile" asp-action="Index" class="side-link side-link--active">Профиль и заказы</a>
            <a asp-controller="Booking" asp-action="My" class="side-link">Мои записи</a>
            <a asp-controller="Events" asp-action="Index" class="side-link">Мероприятия</a>
            <a asp-controller="Cart" asp-action="Index" class="side-link">Корзина</a>
            <a asp-controller="Reviews" asp-action="Create" class="side-link">Оставить отзыв</a>
        </aside>

        <div class="cabinet__content">
            <h1>Здравствуйте, @Model.FullName</h1>

            <form asp-action="Edit" method="post" class="form-card profile-form">
                <h3>Мой профиль</h3>
                <label>Email</label>
                <input type="email" value="@Model.Email" disabled />

                <label asp-for="FullName"></label>
                <input asp-for="FullName" />

                <label asp-for="Phone"></label>
                <input asp-for="Phone" placeholder="+7 (___) ___-__-__" />

                <button type="submit" class="btn">Сохранить</button>
            </form>

            <h2 class="cabinet__title">Мои мероприятия</h2>
            @if (!events.Any())
            {
                <p class="muted">Вы не зарегистрированы на ближайшие мероприятия. <a asp-controller="Events" asp-action="Index">Посмотреть календарь</a></p>
            }
            else
            {
                <table class="table">
                    <thead><tr><th>Мероприятие</th><th>Дата и время</th><th>Место</th></tr></thead>
                    <tbody>
                        @foreach (var r in events)
                        {
                            <tr>
                                <td>@r.Event.Title</td>
                                <td>@r.Event.StartsAt.ToString("d MMMM, HH:mm")</td>
                                <td>@r.Event.Place</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h2 class="cabinet__title">История заказов</h2>
            @if (!orders.Any())
            {
                <p class="muted">Заказов пока нет. <a asp-controller="Products" asp-action="Index">Перейти в магазин</a></p>
            }
            else
            {
                <table class="table">
                    <thead><tr><th>Заказ</th><th>Дата</th><th>Состав</th><th>Сумма</th><th>Статус</th></tr></thead>
                    <tbody>
                        @foreach (var o in orders)
                        {
                            <tr>
                                <td>№ @o.Id</td>
                                <td>@o.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td>@(string.Join(", ", o.Items.Select(i => $"{i.Product.Title} × {i.Quantity}")))</td>
                                <td>@o.Total.ToString("N0") ₽</td>
                                <td><span class="status status--order-@(o.Status.ToString().ToLower())">@o.Status.ToRussian()</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</section>
