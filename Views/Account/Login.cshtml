@model LoginViewModel
@{
    ViewData["Title"] = "Вход";
}
<section class="section">
    <div class="container auth">
        <img class="auth__photo" src="~/img/auth.jpg" alt="Руки в глине за гончарным кругом" />
        <div class="form-page">
        <h1>Вход</h1>
        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="form-card">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <label asp-for="Email"></label>
            <input asp-for="Email" />
            <span asp-validation-for="Email" class="field-error"></span>

            <label asp-for="Password"></label>
            <input asp-for="Password" />
            <span asp-validation-for="Password" class="field-error"></span>

            <label class="checkbox">
                <input asp-for="RememberMe" /> Запомнить меня
            </label>

            <button type="submit" class="btn btn--wide">Войти</button>
            <p class="muted small">Нет аккаунта? <a asp-action="Register">Зарегистрируйтесь</a></p>
        </form>
        </div>
    </div>
</section>
